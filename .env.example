# ==============================================================================
# HIPPOCRATES AI CLINICAL COPILOT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate with your own credentials.
# NEVER commit .env.local or any actual API keys/secrets to version control.

# ------------------------------------------------------------------------------
# 1. AI Engine: Google Gemini (Primary Clinical Engine)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-2.5-flash / gemini-2.0-flash / gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Voice AI: ElevenLabs Conversational AI (Aegis Pro Voice)
# ------------------------------------------------------------------------------
# Required for real-time patient voice conversations
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
AEGIS_PRO_AGENT_ID=your_elevenlabs_agent_id_here

# ------------------------------------------------------------------------------
# 3. Supabase PostgreSQL & Storage
# ------------------------------------------------------------------------------
# Project URL & Anon key (Client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_jwt_here

# Supabase Service Role Key (Server-only, NEVER expose to browser)
# Used only by backend server operations requiring privileged execution
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 4. Administrator Authentication & Session Security
# ------------------------------------------------------------------------------
# Strong random secret used to sign admin session cookies (min 32 characters)
ADMIN_SESSION_SECRET=generate_a_random_32_char_secret_string_here
# Administrator credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# ------------------------------------------------------------------------------
# 5. Production & Deployment Site URL
# ------------------------------------------------------------------------------
# Set this to your deployed domain in production (e.g., https://hippocrates.vercel.app)
# to ensure OAuth sign-in providers redirect back to your deployed domain rather than localhost.
NEXT_PUBLIC_SITE_URL=https://your-production-app.vercel.app

# ------------------------------------------------------------------------------
# 6. Optional Multi-Provider Settings
# ------------------------------------------------------------------------------
OPENAI_API_KEY=optional_openai_api_key_here